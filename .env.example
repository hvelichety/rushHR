# RushHour Environment Variables
# Copy this file to .env and fill in your values

# Queue + restaurant catalog API on Railway (see backend/RAILWAY.md)
# Home tab restaurants and Call & Ask both use this service.
EXPO_PUBLIC_QUEUE_API_URL=https://your-queue-service.up.railway.app

# Legacy Flask backend (optional — wait-time /call and live SSE stream only)
EXPO_PUBLIC_API_URL=https://your-backend-url.com
# API Key for legacy Flask /call endpoint (optional if you only use Vapi Call & Ask)
EXPO_PUBLIC_API_KEY=your-api-key-here

# EAS Configuration (optional)
# Get this from https://expo.dev after creating a project
EAS_PROJECT_ID=your-eas-project-id
