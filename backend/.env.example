# Copy this file to .env and paste your real values there (do NOT put secrets in .env.example)
#
# Railway → Postgres → Variables:
#   - For local dev on your Mac: use DATABASE_PUBLIC_URL or the external connection URL
#   - postgres.railway.internal only works inside Railway, not from localhost
#
DATABASE_URL=postgresql://user:password@host:port/railway

PORT=5001

# Vapi voice calling (outbound "Call & Ask" from the Home tab)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Optional — only if model override fails; otherwise loaded from your Vapi assistant
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL_NAME=gpt-4o
# E.164 number shown in the app (your Vapi/Twilio outbound caller ID)
# Important for Test calls: iPhones often silence unknown out-of-state numbers unless this is in Contacts
# or Silence Unknown Callers is off (Settings → Phone).
VAPI_FROM_NUMBER=+12296005806
# Public URL of this service + /webhooks/vapi (Railway domain)
VAPI_WEBHOOK_URL=https://your-queue-service.up.railway.app/webhooks/vapi

# Yelp Places API — auto-discovers call-worthy restaurants
# Sign up: https://www.yelp.com/developers/v3/manage_app
# Trial: 5,000 calls / 30 days (evaluation). Paid plans start ~$229/mo (see Yelp pricing).
YELP_API_KEY=
# Optional tuning:
# YELP_SYNC_TTL_HOURS=24
# YELP_SYNC_MAX_RESULTS=200
# YELP_SYNC_RADIUS_METERS=40000
# YELP_SYNC_EXTRA_LOCATIONS=Princeton, NJ,New Brunswick, NJ
